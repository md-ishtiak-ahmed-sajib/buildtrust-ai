BUILDTRUST_DATA_DIR=./data
BUILDTRUST_DEMO_MODE=true
BUILDTRUST_MINIMUM_RESERVE=100000.00
BUILDTRUST_ADMIN_CEILING=1000000.00
BUILDTRUST_APPROVAL_MINUTES=30
BUILDTRUST_RECEIVABLE_DELAY_DAYS=15
BUILDTRUST_COST_PRESSURE_PERCENT=10
BUILDTRUST_LLM_PROVIDER=none
BUILDTRUST_OLLAMA_URL=http://127.0.0.1:11434
BUILDTRUST_OLLAMA_MODEL=
# Optional online price adapters; leave empty for a truthful unavailable state.
BUILDTRUST_SERPAPI_KEY=
BUILDTRUST_DATAFORSEO_LOGIN=
BUILDTRUST_DATAFORSEO_PASSWORD=
BUILDTRUST_PRICE_TIMEOUT_SECONDS=15
# Optional OCR: install pinned models with scripts/setup_ocr.py first.
BUILDTRUST_OCR_ENABLED=false
BUILDTRUST_OCR_TESSDATA_DIR=./data/ocr-models
BUILDTRUST_OCR_LANGUAGES=eng+ben
BUILDTRUST_BACKGROUND_JOBS=true
BUILDTRUST_JOB_POLL_SECONDS=2
# Setup generates a private signing secret and demo credentials in data/.
