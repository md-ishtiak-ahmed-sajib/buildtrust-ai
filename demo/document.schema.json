{
  "$defs": {
    "ItemInput": {
      "properties": {
        "item_code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Item Code",
          "type": "string"
        },
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "unit_rate": {
          "default": "0",
          "title": "Unit Rate",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        }
      },
      "required": [
        "item_code",
        "description",
        "quantity",
        "unit"
      ],
      "title": "ItemInput",
      "type": "object"
    }
  },
  "properties": {
    "document_type": {
      "enum": [
        "BOQ",
        "PO",
        "GRN",
        "INVOICE",
        "VARIATION"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "supplier_code": {
      "default": "",
      "maxLength": 80,
      "title": "Supplier Code",
      "type": "string"
    },
    "po_number": {
      "default": "",
      "maxLength": 100,
      "title": "Po Number",
      "type": "string"
    },
    "receipt_number": {
      "default": "",
      "maxLength": 100,
      "title": "Receipt Number",
      "type": "string"
    },
    "invoice_number": {
      "default": "",
      "maxLength": 100,
      "title": "Invoice Number",
      "type": "string"
    },
    "invoice_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invoice Date"
    },
    "currency": {
      "default": "BDT",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "beneficiary_fingerprint": {
      "default": "",
      "maxLength": 128,
      "title": "Beneficiary Fingerprint",
      "type": "string"
    },
    "subtotal": {
      "default": "0",
      "title": "Subtotal",
      "type": "string"
    },
    "tax": {
      "default": "0",
      "title": "Tax",
      "type": "string"
    },
    "retention": {
      "default": "0",
      "title": "Retention",
      "type": "string"
    },
    "discount": {
      "default": "0",
      "title": "Discount",
      "type": "string"
    },
    "grand_total": {
      "default": "0",
      "title": "Grand Total",
      "type": "string"
    },
    "tax_percent": {
      "default": "0",
      "title": "Tax Percent",
      "type": "string"
    },
    "retention_percent": {
      "default": "0",
      "title": "Retention Percent",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 20000,
      "title": "Notes",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemInput"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "document_type",
    "items"
  ],
  "title": "DocumentInput",
  "type": "object"
}